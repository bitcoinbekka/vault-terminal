# Vault Terminal — build-time environment variables
#
# All are optional. Set them before `npm run build` (or in a real `.env`).

# Same-origin reverse-proxy base (RECOMMENDED for self-hosting).
# When set, market data is fetched from /yahoo/* and /cboe/* on this origin.
# Because the app and the proxy share an origin, browsers apply no CORS
# restrictions at all — no third-party proxy is involved.
# See deploy/nginx-vault.conf for the matching nginx config.
VITE_MARKET_BASE=https://vault.example.com

# Custom CORS proxy (optional override).
# Must follow the `?url=` convention used by the default:
#   https://proxy.shakespeare.diy/?url=<encoded-url>
# Set this to a proxy you control if you don't use the same-origin setup above.
# VITE_CORS_PROXY=https://your-vps.example.com/cors?url=
