# Vault Terminal — build-time environment variables
#
# All are optional unless noted. Set them before `npm run build` (or in a real `.env`).

# REQUIRED for live market data: your Finnhub API key.
# Sign up free at https://finnhub.io → Dashboard → API Key.
# The key is embedded in the built JS — use a token with only read access.
VITE_FINNHUB_TOKEN=your_finnhub_token_here

# Same-origin reverse-proxy base (for CBOE options proxying on self-hosted installs).
# When set, CBOE options data is fetched from /cboe/* on this origin.
# See deploy/nginx-vault.conf for the matching nginx config.
# VITE_MARKET_BASE=https://vault.example.com

# Custom CORS proxy (optional override, only needed if Finnhub CORS ever breaks).
# Must follow the `?url=` convention:
#   https://proxy.shakespeare.diy/?url=<encoded-url>
# VITE_CORS_PROXY=https://your-vps.example.com/cors?url=
